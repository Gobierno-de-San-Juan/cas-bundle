{
    "name": "jkober/cas-bundle",
    "type": "symfony-bundle",
    "description": "Bundle de cas para symfony 6.4 y 7.x",
    "homepage": "https://github.com/deimsantafe/stg-cas-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "apereo/phpcas": "^1.6",
	    "symfony/security-bundle": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/routing": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": { "Stg\\Bundle\\CasBundle\\": "" }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "codeception/aspect-mock": "*",
        "phpunit/phpunit": "~7.5",
        "symfony/debug": "~5.4",
        "symfony/phpunit-bridge": "~5.4"
    }
}
